<Window
    x:Class="WindowsAIPhotos.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows AI Photos">
  <!-- Frosted-glass look: the window is acrylic, panels are translucent glass on top. -->
  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop/>
  </Window.SystemBackdrop>
  <Grid x:Name="Root" Loaded="Root_Loaded" Background="Transparent">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GlassPanelBrush" Color="#99FFFFFF"/>
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="#CCFFFFFF"/>
            <!-- In-app acrylic: blurs the photos scrolling underneath. -->
            <AcrylicBrush x:Key="GlassAcrylicBrush" TintColor="#FFFFFF" TintOpacity="0.45" FallbackColor="#F3F3F3"/>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GlassPanelBrush" Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="#26FFFFFF"/>
            <AcrylicBrush x:Key="GlassAcrylicBrush" TintColor="#1C1C1E" TintOpacity="0.5" FallbackColor="#2C2C2E"/>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
          <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
          <Setter Property="CornerRadius" Value="10"/>
        </Style>
      </ResourceDictionary>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="244"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Library navigation sidebar: a floating glass card -->
    <Border Grid.Column="0" Margin="10,10,0,10" CornerRadius="16"
            Background="{ThemeResource GlassPanelBrush}"
            BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1">
      <Grid Padding="20,24,16,20" RowSpacing="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
          <TextBlock Text="PHOTOS" FontSize="11" FontWeight="SemiBold" Opacity="0.6"/>
          <TextBlock Text="Windows AI Photos" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="Private, local-first photo library" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Row="1" x:Name="LibraryButton" Click="LibraryButton_Click"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <SymbolIcon Symbol="Pictures"/>
            <TextBlock Text="All Photos  ·  全部照片"/>
          </StackPanel>
        </Button>
        <StackPanel Grid.Row="2" Spacing="10">
          <ComboBox x:Name="MediaFilter" Header="媒体分类 / Media" SelectedIndex="0" SelectionChanged="MediaFilter_SelectionChanged" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="全部 / All"/><ComboBoxItem Content="照片 / Photos"/><ComboBoxItem Content="视频 / Videos"/><ComboBoxItem Content="截图 / Screenshots"/>
          </ComboBox>
          <TextBlock Text="SOURCE FOLDERS / 来源目录" FontSize="11" FontWeight="SemiBold" Opacity="0.65"/>
          <Button x:Name="AddFolderButton" Click="AddFolderButton_Click"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SymbolIcon Symbol="Add"/>
              <TextBlock Text="Add photo folder"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <Grid Grid.Row="3" RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ListView x:Name="FolderList" IsItemClickEnabled="False"
                    SelectionMode="Single" HorizontalContentAlignment="Stretch" FontSize="12"/>
          <Button x:Name="RemoveFolderButton" Grid.Row="1" Click="RemoveFolderButton_Click"
                  HorizontalAlignment="Stretch" Content="Remove selected folder"/>
        </Grid>
        <StackPanel Grid.Row="4" Spacing="8">
          <Border Padding="12" CornerRadius="12" Background="{ThemeResource GlassPanelBrush}"
                  BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1">
            <StackPanel Spacing="5">
              <TextBlock Text="ON-DEVICE AI" FontSize="11" FontWeight="SemiBold" Opacity="0.65"/>
              <TextBlock x:Name="AiState" Text="Checking..." TextWrapping="Wrap" FontSize="12"/>
              <Button x:Name="AiButton" Click="AiButton_Click" HorizontalAlignment="Stretch">
                <TextBlock Text="Install AI (~1.5 GB)"/>
              </Button>
            </StackPanel>
          </Border>
          <TextBlock Text="LIBRARY TOOLS" FontSize="11" FontWeight="SemiBold" Opacity="0.65"/>
          <Button x:Name="OrganizeButton" Click="OrganizeButton_Click"
                  HorizontalAlignment="Stretch" Content="Organize / 整理照片"/>
          <Button x:Name="DuplicatesButton" Click="DuplicatesButton_Click"
                  HorizontalAlignment="Stretch" Content="Find duplicates / 查找重复"/>
          <Button x:Name="IPhoneImportButton" Click="IPhoneImportButton_Click"
                  HorizontalAlignment="Stretch" Content="从 iPhone 导入（数据线）"/>
          <ToggleSwitch x:Name="AutoImportToggle" Toggled="AutoImportToggle_Toggled" Margin="0,-6,0,0"
                        OnContent="插上 iPhone 自动导入" OffContent="插上 iPhone 自动导入" FontSize="12"/>
          <HyperlinkButton x:Name="ImportDestinationButton" Click="ImportDestinationButton_Click" Margin="0,-8,0,0"
                           Padding="2,0" ToolTipService.ToolTip="iPhone 照片按月份保存到这个文件夹">
            <TextBlock x:Name="ImportDestinationText" FontSize="11" TextWrapping="Wrap"
                       Text="保存位置：未设置（点此选择）"/>
          </HyperlinkButton>
          <Button x:Name="MobileButton" Click="MobileButton_Click"
                  HorizontalAlignment="Stretch" Content="Enable iPhone pairing / 开启同步"/>
          <Button x:Name="ManageSyncButton" Click="ManageSyncButton_Click"
                  HorizontalAlignment="Stretch" Content="Manage sync / 设备与传输"/>
          <TextBlock x:Name="SyncStatusText" FontSize="11" Opacity="0.7"
                     TextWrapping="Wrap" Text="iPhone sync: Checking..."/>
          <Button x:Name="BackupButton" Click="BackupButton_Click"
                  HorizontalAlignment="Stretch" Content="Back up to drive / 本地备份"/>
          <Button x:Name="CloudButton" Click="CloudButton_Click"
                  HorizontalAlignment="Stretch" Content="Cloud backup / 云端备份"/>
          <TextBlock Text="Mobile sync and backups are opt-in. No Ollama."
                     TextWrapping="Wrap" FontSize="11" Opacity="0.65"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main photo view -->
    <Grid Grid.Column="1" Padding="24,40,24,0" RowSpacing="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="5">
          <TextBlock x:Name="PageTitle" Text="All Photos" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="Search by what is in a picture, not just its filename."
                     FontSize="12" Opacity="0.7"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="ScanButton" Click="ScanButton_Click" Padding="18,10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <SymbolIcon Symbol="Refresh"/>
            <TextBlock Text="Scan / 扫描"/>
          </StackPanel>
        </Button>
      </Grid>

      <Grid Grid.Row="1" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" PlaceholderText="搜索照片内容，例如：红色裙子、雪山、chiller plant..."
                 Height="44" FontSize="14" KeyDown="SearchBox_KeyDown" CornerRadius="22"/>
        <Button x:Name="SearchButton" Grid.Column="1" Width="108" Height="44" CornerRadius="22"
                Click="SearchButton_Click" Style="{StaticResource AccentButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <SymbolIcon Symbol="Find"/>
            <TextBlock Text="Search"/>
          </StackPanel>
        </Button>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="8">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="Starting local engine..." TextWrapping="Wrap"
                     Opacity="0.75" FontSize="12"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0">
            <TextBlock Text="缩略图" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
            <Slider x:Name="ThumbSize" Width="140" Minimum="110" Maximum="360" StepFrequency="5"
                    Value="185" VerticalAlignment="Center" ValueChanged="ThumbSize_ValueChanged"
                    ToolTipService.ToolTip="调整缩略图大小"/>
          </StackPanel>
          <TextBlock x:Name="PhotoCount" Grid.Column="2" Text="0 photos" FontSize="12" Opacity="0.7"
                     VerticalAlignment="Center"/>
        </Grid>
        <ProgressBar x:Name="WorkProgress" IsIndeterminate="True" Visibility="Collapsed" Height="3"/>
      </StackPanel>

      <Grid Grid.Row="3">
        <GridView x:Name="PhotoGrid" IsItemClickEnabled="True" ItemClick="PhotoGrid_ItemClick"
                  SelectionMode="None" SelectionChanged="PhotoGrid_SelectionChanged" Padding="0" Margin="-10,0,-8,0"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <GridView.Resources>
            <!-- Selection is drawn by the item template (iOS-style check), not the default accent frame. -->
            <x:Boolean x:Key="GridViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
            <Thickness x:Key="GridViewItemSelectedBorderThickness">0</Thickness>
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent"/>
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent"/>
          </GridView.Resources>
          <!-- Room to scroll the last row clear of the floating selection bar. -->
          <GridView.Footer>
            <Border Height="76"/>
          </GridView.Footer>
          <!-- Item size follows the ThumbSize slider (set in code). -->
          <GridView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsWrapGrid Orientation="Horizontal" ItemWidth="185" ItemHeight="195"/>
            </ItemsPanelTemplate>
          </GridView.ItemsPanel>
          <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
          </GridView.ItemContainerStyle>
          <GridView.ItemTemplate>
            <DataTemplate>
              <Grid RowSpacing="6" Padding="5">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                </Border>
                <!-- iOS-style selection: dimmed photo, accent frame and a check, fading in together. -->
                <Grid Opacity="{Binding SelectedOpacity}">
                  <Grid.OpacityTransition>
                    <ScalarTransition/>
                  </Grid.OpacityTransition>
                  <Border CornerRadius="10" Background="#40000000" BorderThickness="3"
                          BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"/>
                  <Grid Width="26" Height="26" Margin="9" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="White" StrokeThickness="2"/>
                    <FontIcon Glyph="&#xE73E;" FontSize="12" FontWeight="Bold" Foreground="White"/>
                  </Grid>
                </Grid>
                <FontIcon Glyph="&#xE768;" FontSize="36" Opacity="{Binding PlaceholderOpacity}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Opacity="{Binding BadgeOpacity}" Background="#B0000000" CornerRadius="4"
                        Padding="6,2" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="2" Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </DataTemplate>
          </GridView.ItemTemplate>
        </GridView>
        <!-- Drag-to-select box, drawn above the grid (see MainWindow.BoxSelection.cs). -->
        <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False">
          <Rectangle x:Name="SelectionBox" Visibility="Collapsed" Opacity="0.3" RadiusX="2" RadiusY="2"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                     Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2"/>
        </Canvas>
        <TextBlock x:Name="EmptyState" Text="Choose Add photo folder to begin."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.65" Visibility="Collapsed"/>
        <!-- Floating glass toolbar; photos scroll underneath it. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Padding="8"
                CornerRadius="18" Background="{ThemeResource GlassAcrylicBrush}"
                BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="SelectButton" Content="选择照片" Click="SelectButton_Click"/>
            <Button x:Name="SelectAllButton" Content="全选已加载" Click="SelectAllButton_Click" Visibility="Collapsed"/>
            <Button x:Name="RecycleButton" Content="移到回收站 (0)" Click="RecycleButton_Click" IsEnabled="False" Visibility="Collapsed"/>
            <TextBlock Text="点击照片打开原图；按住鼠标拖动可框选（Ctrl 追加，Shift+点击连选）；向下滚动自动加载更多"
                       VerticalAlignment="Center" Margin="6,0,8,0" FontSize="11" Opacity="0.7"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- Drag area of the merged title bar (the caption buttons sit above its right end). -->
    <Border x:Name="AppTitleBar" Grid.Column="1" Height="34" VerticalAlignment="Top" Background="Transparent"/>
  </Grid>
</Window>
